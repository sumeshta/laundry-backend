# PostgreSQL
# Docker (docker compose): postgresql://laundry:laundry_secret@localhost:5432/laundry_db
# Local peer auth:       postgresql://YOUR_USER@localhost:5432/laundry_db
DATABASE_URL="postgresql://laundry:laundry_secret@localhost:5432/laundry_db?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=30d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
