generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  staff
  admin
  hub_manager
}

enum StaffRole {
  pickup
  delivery
  hub_operator
  manager
}

enum OrderStatus {
  draft
  pending_confirmation
  confirmed
  pickup_assigned
  pickup_in_progress
  picked_up
  verification_pending
  in_processing
  ready_for_delivery
  out_for_delivery
  delivered
  cancelled
  exception
}

enum PaymentStatus {
  unpaid
  pending
  paid
  refunded
}

enum AssignmentType {
  pickup
  delivery
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         UserRole @default(customer)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customerProfile CustomerProfile?
  staffProfile    StaffProfile?
  addresses       Address[]
  orders          Order[]          @relation("CustomerOrders")
  refreshTokens   RefreshToken[]
  statusChanges   OrderStatusHistory[]
  adjustments     OrderAdjustment[]
  assignments     OrderAssignment[]
  notifications   Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CustomerProfile {
  userId    String   @id @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model StaffProfile {
  userId    String    @id @map("user_id")
  hubId     String    @map("hub_id")
  staffRole StaffRole @map("staff_role")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hub  Hub  @relation(fields: [hubId], references: [id])

  @@map("staff_profiles")
}

model Address {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  label       String   @default("Home")
  line1       String
  line2       String?
  city        String
  postalCode  String?  @map("postal_code")
  country     String   @default("IN")
  latitude    Float
  longitude   Float
  instructions String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Hub {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  line1       String
  city        String
  postalCode  String?  @map("postal_code")
  phone       String?
  latitude    Float
  longitude   Float
  radiusKm    Float    @default(8) @map("radius_km")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  staff   StaffProfile[]
  orders  Order[]

  @@map("hubs")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  name       String
  slug       String   @unique
  unit       String   @default("piece")
  basePrice  Decimal  @map("base_price") @db.Decimal(10, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category  Category       @relation(fields: [categoryId], references: [id])
  lineItems OrderLineItem[]

  @@index([categoryId])
  @@map("products")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String?       @unique @map("order_number")
  customerId      String        @map("customer_id")
  hubId           String?       @map("hub_id")
  status          OrderStatus   @default(draft)
  paymentStatus   PaymentStatus @default(unpaid) @map("payment_status")

  pickupLine1     String?  @map("pickup_line1")
  pickupCity      String?  @map("pickup_city")
  pickupPostal    String?  @map("pickup_postal")
  pickupLatitude  Float?   @map("pickup_latitude")
  pickupLongitude Float?   @map("pickup_longitude")
  pickupInstructions String? @map("pickup_instructions")

  deliveryDate    DateTime? @map("delivery_date") @db.Date
  pickupWindow    String?   @map("pickup_window")
  notes           String?

  estimatedTotal  Decimal? @map("estimated_total") @db.Decimal(10, 2)
  finalTotal      Decimal? @map("final_total") @db.Decimal(10, 2)
  hubAssignedAt   DateTime? @map("hub_assigned_at")
  confirmedAt     DateTime? @map("confirmed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer    User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  hub         Hub?                 @relation(fields: [hubId], references: [id])
  lineItems   OrderLineItem[]
  history     OrderStatusHistory[]
  adjustments OrderAdjustment[]
  assignments OrderAssignment[]

  @@index([customerId])
  @@index([hubId])
  @@index([status])
  @@map("orders")
}

model OrderLineItem {
  id              String  @id @default(cuid())
  orderId         String  @map("order_id")
  productId       String  @map("product_id")
  quantity        Int     @default(1)
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(10, 2)
  productName     String  @map("product_name")
  notes           String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_line_items")
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String      @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus @map("to_status")
  actorId    String?     @map("actor_id")
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

model OrderAdjustment {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  reason      String
  amountDelta Decimal  @map("amount_delta") @db.Decimal(10, 2)
  actorId     String?  @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@map("order_adjustments")
}

model OrderAssignment {
  id         String         @id @default(cuid())
  orderId    String         @map("order_id")
  staffId    String         @map("staff_id")
  type       AssignmentType
  assignedAt DateTime       @default(now()) @map("assigned_at")
  completedAt DateTime?     @map("completed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff User  @relation(fields: [staffId], references: [id])

  @@unique([orderId, type])
  @@map("order_assignments")
}

model PlatformSettings {
  id        String   @id @default("default")
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String    @default("new_order")
  title     String
  message   String
  orderId   String?   @map("order_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}
